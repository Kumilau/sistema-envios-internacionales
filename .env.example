# CONFIGURACIÓN ZOOM.RED - Sistema de Envíos Internacionales

# CREDENCIALES ZOOM.RED
# Estos datos se obtienen de tu cuenta en zoom.red
ZOOM_USER=tu_usuario_zoom
ZOOM_PASSWORD=tu_contraseña
ZOOM_COMPANY_CODE=tu_código_empresa

# CONFIGURACIÓN DEL SERVIDOR
PORT=3000
NODE_ENV=production
APP_BASIC_USER=operador
APP_BASIC_PASSWORD=cambia-esta-clave

# DATOS DE LA EMPRESA (Información visible en los invoices)
COMPANY_NAME=SOCIEDAD COMERCIAL TRANSPORTE
COMPANY_RIF=J-12345678-0
COMPANY_PHONE=0501-9666000
COMPANY_EMAIL=info@tuempresa.com

# CONFIGURACIÓN DE ZOOM.RED API
ZOOM_API_URL=https://www2.zoom.red/api/v1
ZOOM_AUTH_ENDPOINT=/auth/login
ZOOM_SHIPMENT_ENDPOINT=/envios/create

# BASE DE DATOS (para futura integración)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=envios_db
